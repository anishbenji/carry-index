# Security headers for the public site (architecture doc, "Security headers"; unified brief: COOP and CORP).
# Vite copies public/ into dist/client; packages/deploy's gate requires this file and checks every rule
# (packages/deploy/src/headers.ts). Format and host patterns:
# https://developers.cloudflare.com/workers/static-assets/headers/ (a host placeholder matches anything but ".").
# The build (apps/web/build/static-site.ts) copies this file into the site with the CSP line replaced: the same policy,
# with the hashes of the inline stylesheet (and any inline script) every page shares; the build fails if pages need
# different hashes. The line below is that policy with no hashes. Never 'unsafe-inline'. Never auto-merged: the
# owner merges.

/*
  Content-Security-Policy: default-src 'none'; script-src 'none'; style-src 'none'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# ADR-0045: noindex on the workers.dev hosts only, never on carryjournal.com. The first pattern is Cloudflare's
# documented one for "*.*.workers.dev" (<worker>.<subdomain> and version-preview hosts); the second covers a
# single-label <subdomain>.workers.dev host.
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

https://:subdomain.workers.dev/*
  X-Robots-Tag: noindex

/assets/*
  Cache-Control: public, max-age=31536000, immutable
