# Generated at build time from apps/web/public/_headers. Static build (external CSS): one hash set covers all 14 pages.
https://:worker.:account.workers.dev/*
  X-Robots-Tag: noindex

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-8CUbeTkNF81cttU2jYUxGhau4N96/fwsZtRPn7Bz1Nc='; style-src 'self'; img-src 'self'; connect-src 'self'; font-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'; manifest-src 'none'; media-src 'none'; frame-src 'none'; worker-src 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/_static/*
  Cache-Control: public, max-age=31536000, immutable
